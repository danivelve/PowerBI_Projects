table sales

	measure 'Total Sales' = COUNTROWS ( sales )
		formatString: #,0

	measure 'Median Price' = MEDIAN ( sales[sale_price] )
		formatString: \$#,0

	measure 'Average Price' = AVERAGE ( sales[sale_price] )
		formatString: \$#,0

	measure 'Machine Models' = DISTINCTCOUNT ( sales[model_id] )
		formatString: #,0

	measure 'Share Under 40k' = DIVIDE ( CALCULATE ( [Total Sales], sales[sale_price] < 40000 ), [Total Sales] )
		formatString: 0%

	measure 'Median Price Known Age' = IF ( SELECTEDVALUE ( sales[age_band] ) <> "Unknown", [Median Price] )
		formatString: \$#,0

	measure 'Sales Top 10 States' = IF ( RANKX ( ALLSELECTED ( sales[state] ), [Total Sales] ) <= 10, [Total Sales] )
		formatString: #,0

	measure 'Unknown Build Year Share' = DIVIDE ( COUNTBLANK ( sales[year_made] ), [Total Sales] )
		formatString: 0.0%

	column sale_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: sale_date

		annotation UnderlyingDateTimeDataType = Date

	column sale_year
		dataType: int64
		summarizeBy: none
		sourceColumn: sale_year

	column sale_month
		dataType: int64
		summarizeBy: none
		sourceColumn: sale_month

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: sale_month

	column weekday_order
		dataType: int64
		summarizeBy: none
		sourceColumn: weekday_order

	column weekday
		dataType: string
		summarizeBy: none
		sourceColumn: weekday
		sortByColumn: weekday_order

	column state
		dataType: string
		summarizeBy: none
		sourceColumn: state

	column product_group
		dataType: string
		summarizeBy: none
		sourceColumn: product_group

	column product_size
		dataType: string
		summarizeBy: none
		sourceColumn: product_size
		sortByColumn: product_size_order

	column product_size_order
		dataType: int64
		summarizeBy: none
		sourceColumn: product_size_order

	column year_made
		dataType: int64
		summarizeBy: none
		sourceColumn: year_made

	column machine_age
		dataType: int64
		summarizeBy: none
		sourceColumn: machine_age

	column age_band
		dataType: string
		summarizeBy: none
		sourceColumn: age_band
		sortByColumn: age_band_order

	column age_band_order
		dataType: int64
		summarizeBy: none
		sourceColumn: age_band_order

	column model_id
		dataType: int64
		summarizeBy: none
		sourceColumn: model_id

	column sale_price
		dataType: int64
		summarizeBy: none
		sourceColumn: sale_price

	column price_band
		dataType: string
		summarizeBy: none
		sourceColumn: price_band
		sortByColumn: price_band_order

	column price_band_order
		dataType: int64
		summarizeBy: none
		sourceColumn: price_band_order

	partition sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "sales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"sale_date", type date}, {"sale_year", Int64.Type}, {"sale_month", Int64.Type}, {"month_name", type text}, {"weekday_order", Int64.Type}, {"weekday", type text}, {"state", type text}, {"product_group", type text}, {"product_size", type text}, {"product_size_order", Int64.Type}, {"year_made", Int64.Type}, {"machine_age", Int64.Type}, {"age_band", type text}, {"age_band_order", Int64.Type}, {"model_id", Int64.Type}, {"sale_price", Int64.Type}, {"price_band", type text}, {"price_band_order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
