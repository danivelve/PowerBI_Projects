table error_by_price_band

	measure 'Price Bias' = MAX ( error_by_price_band[bias] )
		formatString: 0%

	column price_band
		dataType: string
		summarizeBy: none
		sourceColumn: price_band
		sortByColumn: band_order

	column band_order
		dataType: int64
		summarizeBy: none
		sourceColumn: band_order

	column rmsle
		dataType: double
		summarizeBy: none
		sourceColumn: rmsle

	column sales
		dataType: int64
		summarizeBy: none
		sourceColumn: sales

	column bias
		dataType: double
		summarizeBy: none
		sourceColumn: bias

	partition error_by_price_band = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "error_by_price_band.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"price_band", type text}, {"band_order", Int64.Type}, {"rmsle", type number}, {"sales", Int64.Type}, {"bias", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
