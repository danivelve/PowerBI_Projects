table accuracy_summary

	measure 'Within 25 Percent' = CALCULATE ( MAX ( accuracy_summary[share] ), accuracy_summary[metric] = "Within 25%" )
		formatString: 0%

	column metric
		dataType: string
		summarizeBy: none
		sourceColumn: metric

	column share
		dataType: double
		summarizeBy: none
		sourceColumn: share

	partition accuracy_summary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "accuracy_summary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"metric", type text}, {"share", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
